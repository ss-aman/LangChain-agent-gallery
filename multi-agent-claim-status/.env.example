# ─── LLM (OpenAI-compatible – works with Azure, Ollama, etc.) ───────────────
LLM_PROVIDER=openai                      # openai | azure | ollama | anthropic
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=                            # leave blank for default OpenAI endpoint
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./claims.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/claims_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
CACHE_TTL_SECONDS=300

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_use_32+_random_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Audit ───────────────────────────────────────────────────────────────────
AUDIT_LOG_FILE=./logs/audit.log
LOG_LEVEL=INFO
